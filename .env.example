APP_ENV=development
APP_URL=http://localhost:8080
APP_NAME=OTP Auth
APP_DEBUG=false
APP_KEY=replace-with-a-random-secret-at-least-32-characters

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=otp_auth
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
SES_FROM_EMAIL=no-reply@example.com
SES_FROM_NAME=OTP Auth
SES_CONFIGURATION_SET=
SES_EVENT_TOKEN=replace-with-a-long-random-webhook-secret

OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_MAX_RESENDS_PER_HOUR=5
OTP_MAX_REQUESTS_PER_HOUR=10
OTP_MAX_VERIFY_REQUESTS_PER_HOUR=20
OTP_MAX_PROJECT_REQUESTS_PER_HOUR=100
OTP_RETENTION_DAYS=7
RATE_LIMIT_RETENTION_DAYS=2
SESSION_RETENTION_DAYS=2

API_KEY_HASH_ALGO=sha256
LOG_LEVEL=info
